APP_VERSION=live
# DATABASE_URL — set this on the host to a free external Postgres
# (Supabase or Neon free tier) for live clients. Without it the app uses
# data.json, which is NOT durable on a free host that sleeps/redeploys.
# PORT is set by the host. Never put a real coordinator password here.
# TikTok Login Kit OAuth (coordinator sets these in the hosting dashboard,
# copied from the TikTok developer app page — never in chat, never in git):
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Optional: TOKEN_VAULT_KEY=  (a long random string; encrypts stored TikTok
# tokens at rest. Without it, tokens are encrypted with a key derived from
# the coordinator setup, which is weaker.)
